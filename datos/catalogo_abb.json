  "importRules": {
    "_ayuda": "Reglas del importador de PDF de ABB e-Design DOC. Son expresiones regulares; el código (importador.py) no conoce modelos ni textos fijos.",
    "tagPattern": "-(QF\\d+|QS\\d+)\\b",
    "upstreamContextChars": 40,
    "upstreamPattern": "\\bDE\\s+[\\w .\\-]+?\\s-\\s*$",
    "evidenceChars": 90,
    "modelTerminators": [
      "[234]x\\d+(?:,\\d+)?(?:\\+\\d+x\\d+(?:,\\d+)?)?\\+PE",
      "\\s-WC\\d+",
      "\\sSECCIONADOR"
    ],
    "polesPatterns": [
      "\\b(\\d)x\\d+(?:,\\d+)?\\s*-\\s*\\d+(?:,\\d+)?\\s*kA",
      "\\b\\d+\\s*A\\s*-\\s*(\\d)P\\b"
    ],
    "ratingPattern": "\\b(\\d)x(\\d+(?:,\\d+)?)\\s*-\\s*(\\d+(?:,\\d+)?)\\s*kA",
    "modelParts": "^(?P<serie>(?:SN|S)\\s?\\d{3}[A-Z]?|XT\\d[A-Z]?|T\\d[A-Z]?|OT\\d+[A-Z]+\\d*)[\\s-]*(?:(?P<curva>[BCDKZ])\\s?(?P<In>\\d+(?:[.,]\\d+)?))?\\s*(?P<sufijo>NA)?\\b",
    "_ayudaMarcado": "ratingPattern lee 'polos x In - kA' de la columna I Nom - Icc; modelParts separa serie, curva, In y sufijo del modelo para grabarlos en el frente."
  },
  "modelHints": [
    {
      "_ayuda": "Modelos sin carcasa CAD todavía: el editor sabe cómo montarlos aunque no tenga su bloque.",
      "modelRegex": "^S\\s?251\\b",
